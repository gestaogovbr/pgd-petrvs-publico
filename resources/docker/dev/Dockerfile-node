FROM node:20-alpine
RUN apk add --no-cache \
    ca-certificates \
    chromium \
    freetype \
    harfbuzz \
    nss \
    ttf-freefont \
    && if [ -x /usr/bin/chromium-browser ]; then \
        ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome; \
    elif [ -x /usr/bin/chromium ]; then \
        ln -sf /usr/bin/chromium /usr/bin/google-chrome; \
    fi
ENV CHROME_BIN=/usr/bin/google-chrome
RUN mkdir -p /usr/src/app /usr/src/back-end/public /usr/src/back-end/resources \
    && chown -R node:node /usr/src/app /usr/src/back-end/public /usr/src/back-end/resources \
    && chmod -R 775 /usr/src/app /usr/src/back-end/public /usr/src/back-end/resources
WORKDIR /usr/src/app
VOLUME /usr/src/app
EXPOSE 4200
COPY init-node.sh /usr/local/bin/
USER node
ENTRYPOINT []
